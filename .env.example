# Copy to .env and fill in. The .env file is gitignored.
# Impressum (legal notice) — § 5 DDG requires a real postal address.
#
# ALL values must be Base64-ENCODED (not plaintext) so no imprint detail ships in
# the delivered HTML / JS bundle. They are decoded in the browser only after the
# visitor clicks "Angaben anzeigen". Encode each value with:
#   node -e "console.log(Buffer.from('YOUR VALUE').toString('base64'))"
NUXT_PUBLIC_IMPRINT_NAME=
NUXT_PUBLIC_IMPRINT_STREET=
NUXT_PUBLIC_IMPRINT_CITY=
NUXT_PUBLIC_IMPRINT_COUNTRY=
NUXT_PUBLIC_IMPRINT_EMAIL=
NUXT_PUBLIC_IMPRINT_PHONE=
